# Vercel project env vars (production). Pull real values: vercel env pull
BLOB_READ_WRITE_TOKEN=   # created by `vercel blob create-store room-watch-store --access private`
STORAGE_PASSWORD=        # what the away page asks for
SESSION_SECRET=          # openssl rand -hex 32
DEVICE_TOKEN=            # openssl rand -hex 24 — must match firmware config.h
TIMELINE_RETENTION_HOURS= # optional, default 24 — how long the rolling timeline + telemetry are kept
