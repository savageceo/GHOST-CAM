# Vercel project env vars. Pull real values: vercel env pull
# DATABASE_URL / REDIS_URL / BLOB_READ_WRITE_TOKEN are provisioned by their
# Vercel integrations (Neon, Upstash, Blob). The three secrets below them
# (STORAGE_PASSWORD / SESSION_SECRET / DEVICE_TOKEN) you set yourself.

# ── required ───────────────────────────────────────────────────────────────
DATABASE_URL=            # Neon Postgres (pooled) — index / state / telemetry
REDIS_URL=               # Upstash Redis — WebSocket live-stream fan-out
BLOB_READ_WRITE_TOKEN=   # Vercel Blob private store — image bytes
STORAGE_PASSWORD=        # the login password the away page asks for
SESSION_SECRET=          # openssl rand -hex 32 — signs the session cookie
DEVICE_TOKEN=            # openssl rand -hex 24 — must match firmware config.h

# ── optional ───────────────────────────────────────────────────────────────
TIMELINE_HOURS=           # default 3  — how long the 1s image timeline is kept
TIMELINE_RETENTION_HOURS= # default 24 — how long telemetry is kept
CRON_SECRET=              # openssl rand -hex 16 — Vercel Cron auth (sent as Bearer)
NEXT_PUBLIC_SITE_URL=     # e.g. https://room-watch-six.vercel.app — OpenGraph / absolute URLs
GEOFENCE_KEY=             # openssl rand -hex 16 — iPhone auto-arm hook (/api/geofence?key=…&arm=1|0)
