# Vercel project env vars (production). Pull real values: vercel env pull
BLOB_READ_WRITE_TOKEN=   # created by `vercel blob create-store room-watch-store --access private`
STORAGE_PASSWORD=        # what the away page asks for
SESSION_SECRET=          # openssl rand -hex 32
DEVICE_TOKEN=            # openssl rand -hex 24 — must match firmware config.h
TIMELINE_RETENTION_HOURS= # optional, default 24 — how long the rolling timeline + telemetry are kept
CRON_SECRET=             # optional, openssl rand -hex 16 — Vercel Cron auth (sent as Bearer)
NEXT_PUBLIC_SITE_URL=    # optional, e.g. https://room-watch-six.vercel.app — for OpenGraph/absolute URLs
# ── coming with the Neon + live-stream milestone ──────────────────────────
DATABASE_URL=            # Neon Postgres connection string (pooled) — enables the DB features
REDIS_URL=               # Upstash Redis (Vercel Marketplace) — WebSocket live-stream fan-out
