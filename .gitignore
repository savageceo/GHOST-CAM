# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local drop zone for ./up.sh — contents are uploads, not source
/drop/*
!/drop/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firmware secrets — copy config.h.example -> config.h and fill in locally
firmware/**/config.h

# neon/drizzle local cache
.neon
